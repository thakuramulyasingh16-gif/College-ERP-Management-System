PORT=5000
NODE_ENV=development

# Database Configuration (TiDB / MySQL)
DB_HOST=localhost
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=erp_db
TIDB_ENABLE_SSL=true

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Configuration (Profile Photos & Study Material PDFs)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email Configuration (Resend API for Forgot Password OTP)
# Sign up at https://resend.com (free 3,000 emails/mo) and add your API key:
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="ERP Portal <onboarding@resend.dev>"

# AI Study Assistant (Students only, read-only, disabled by default)
ASSISTANT_ENABLED=false
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
ASSISTANT_HOURLY_LIMIT=20
ASSISTANT_DAILY_LIMIT=80
ATTENDANCE_MIN_PERCENT=75


